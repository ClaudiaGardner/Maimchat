{
  "manifest_version": 2,
  "id": "maim-with-u.maimchat-device",
  "version": "1.1.0",
  "name": "Maimchat Android 设备控制",
  "description": "让 MaiBot 直接驱动 Maimchat 的 Live2D 表情与动作，使用设备摄像头，并支持视频通话语音输出。",
  "author": {
    "name": "Mai-with-u contributors",
    "url": "https://github.com/MaiM-with-u"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/ClaudiaGardner/Maimchat",
    "documentation": "https://github.com/ClaudiaGardner/Maimchat/tree/dev/integrations/maibot_plugin",
    "issues": "https://github.com/ClaudiaGardner/Maimchat/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.5.4",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "send.custom"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
